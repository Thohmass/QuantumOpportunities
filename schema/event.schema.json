{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event (one edition)",
  "description": "An absent key means 'not found yet'. The string 'n/a' means 'checked, does not apply' and is allowed only where listed. See docs/02-data-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "status", "format", "dates", "sources", "checks", "added"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "series": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 3, "maxLength": 120 },
    "type": { "type": "string" },
    "status": { "enum": ["confirmed", "expected", "postponed", "cancelled"] },
    "format": { "enum": ["in_person", "online", "hybrid"] },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "$ref": "#/$defs/partialDate" },
        "end": { "$ref": "#/$defs/partialDate" },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "deadlines": {
      "oneOf": [
        { "const": "n/a" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date"],
            "properties": {
              "kind": {
                "enum": ["application", "registration", "abstract", "early_bird", "other"]
              },
              "date": { "$ref": "#/$defs/partialDate" },
              "note": { "$ref": "#/$defs/note" }
            }
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "country"],
      "properties": {
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "venue": { "type": "string", "maxLength": 120 },
        "latlon": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "number", "minimum": -180, "maximum": 180 }
          ],
          "items": false,
          "minItems": 2
        },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "organizers": { "$ref": "#/$defs/idList" },
    "partners": { "$ref": "#/$defs/idList" },
    "topics": { "$ref": "#/$defs/idList" },
    "audience": { "oneOf": [{ "const": "n/a" }, { "$ref": "#/$defs/idList" }] },
    "eligibility": { "type": "string", "maxLength": 300 },
    "team": {
      "oneOf": [
        { "const": "n/a" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": { "type": "integer", "minimum": 1, "maximum": 100 },
            "max": { "type": "integer", "minimum": 1, "maximum": 100 },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "hardware": {
      "oneOf": [
        { "const": "n/a" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["real_qpu"],
          "properties": {
            "real_qpu": { "type": "boolean" },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "prizes": { "oneOf": [{ "const": "n/a" }, { "type": "string", "maxLength": 200 }] },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["free", "paid", "mixed"] },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "support": {
      "oneOf": [
        { "const": "n/a" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["travel_grants"],
          "properties": {
            "travel_grants": { "type": "boolean" },
            "note": { "$ref": "#/$defs/note" }
          }
        }
      ]
    },
    "url": { "$ref": "#/$defs/url" },
    "registration_url": { "$ref": "#/$defs/url" },
    "description": { "type": "string", "minLength": 10, "maxLength": 400 },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "confidence"],
      "properties": {
        "basis": { "type": "string", "minLength": 10, "maxLength": 300 },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "kind", "accessed"],
        "properties": {
          "url": { "$ref": "#/$defs/url" },
          "kind": { "enum": ["official", "organiser_social", "aggregator", "news", "other"] },
          "accessed": { "$ref": "#/$defs/fullDate" },
          "note": { "$ref": "#/$defs/note" }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_checked", "unchanged_streak"],
      "properties": {
        "last_checked": { "$ref": "#/$defs/fullDate" },
        "unchanged_streak": { "type": "integer", "minimum": 0 }
      }
    },
    "added": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "by"],
      "properties": {
        "date": { "$ref": "#/$defs/fullDate" },
        "by": { "type": "string", "minLength": 2, "maxLength": 80 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "partialDate": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "fullDate": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 500 },
    "note": { "type": "string", "maxLength": 300 }
  }
}
