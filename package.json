{
  "name": "quantum-opportunities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open, agent-maintained database and website of quantum science events.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run data:build && vite",
    "build": "npm run data:build && vite build && tsx scripts/size-budget.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:check": "tsx scripts/validate.ts",
    "data:build": "tsx scripts/build-data.ts",
    "index": "tsx scripts/index.ts",
    "find-similar": "tsx scripts/find-similar.ts",
    "queue": "tsx scripts/queue.ts",
    "stubs": "tsx scripts/stubs.ts",
    "linkcheck": "tsx scripts/linkcheck.ts",
    "scout-prep": "tsx scripts/scout-prep.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "minisearch": "^7.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/topojson-client": "^3.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "all-the-cities": "^3.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
